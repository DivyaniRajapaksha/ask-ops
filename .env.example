# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=

# Pinecone
PINECONE_INDEX_NAME=ask-ops
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Models (change here, not in code)
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIM=1024
GENERATION_MODEL=claude-sonnet-5-5
CHEAP_MODEL=claude-haiku-5-5
RERANK_MODEL=rerank-v3.5

# Retrieval knobs
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
DENSE_TOP_K=30
SPARSE_TOP_K=30
RRF_K=60
RERANK_TOP_N=6
